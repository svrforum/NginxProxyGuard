{{if .Host.Enabled}}
server {
    listen {{.HTTPPort}};
{{if .EnableIPv6}}    listen [::]:{{.HTTPPort}};
{{end}}    server_name {{join .Host.DomainNames " "}};

    # Initialize tracking variables
    set $block_reason_var "-";
    set $bot_category_var "-";
    set $geo_blocked 0;
    set $is_search_bot 0;

    # NPM-compatible variables for custom config
    set $forward_scheme {{.Host.ForwardScheme}};
    set $server "{{.Host.ForwardHost}}";
    set $port {{.Host.ForwardPort}};

    # Shared host stanza: resolver, ACME/challenge skip vars, custom error pages
    include /etc/nginx/conf.d/includes/host_common.conf;

{{with toRegexPattern .SearchEnginesList}}
    # Search bot detection (set once, used by GeoIP, CloudProvider, BotFilter)
    if ($http_user_agent ~* ({{.}})) {
        set $is_search_bot 1;
    }
{{end}}

    # ACME HTTP-01 Challenge support (bypass all security checks)
    location /.well-known/acme-challenge/ {
        # Allow all access for certificate validation
        allow all;
{{- if .GeoRestriction}}{{if .GeoRestriction.ChallengeMode}}
        auth_request off;
{{- end}}{{end}}
        root /etc/nginx/acme-challenge;
        try_files $uri =404;
    }

{{template "_security" .}}

{{if .GeoRestriction}}{{if .GeoRestriction.ChallengeMode}}
    # Challenge validation endpoint (internal)
    location = /_challenge/validate {
        internal;
        # The 401 below must reach auth_request as a plain 401. Inheriting a
        # server-level "error_page 401 = @challenge_redirect" would turn it
        # into a 302, which auth_request treats as an error (500), and
        # location /'s "error_page 500 = @api_fallback" would then let the
        # request through. Any error_page defined here stops the inheritance.
        error_page 401 = @challenge_gate_deny;
        # nginx decides who is challenged; the API only checks tokens.
        # $geo_blocked is already 0 for allowed countries, private, priority
        # and trusted IPs and, when the host allows them, search bots
        # (_security). Not challenged (an explicit 0 only): allowed here with
        # no API round-trip. Challenged without a token: 401 here, which the
        # caller's error_page 401 turns into the challenge redirect. Only a
        # challenged visitor carrying a token reaches the API.
        if ($geo_blocked = 0) {
            return 204;
        }
        if ($cookie_ng_challenge = "") {
            return 401;
        }
        proxy_pass http://{{apiHost}}/api/v1/challenge/validate;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Proxy-Host-ID "{{.Host.ID}}";
        proxy_set_header X-Challenge-Token $cookie_ng_challenge;
        # Only a challenged visitor gets here. A constant, so no header the
        # client sends can make the API skip the token check.
        proxy_set_header X-Geo-Blocked 1;
        # Fast timeout - fail fast if API is down
        proxy_connect_timeout 2s;
        proxy_read_timeout 5s;
    }

    # Plain 401 for the gate subrequest (see /_challenge/validate).
    location @challenge_gate_deny {
        return 401;
    }

    # API error fallback - allow traffic through when API is down
    location @api_fallback {
        auth_request off;
        # API is down - allow request to proceed (graceful degradation)
        # Log this event for monitoring
        access_log /etc/nginx/logs/access_raw.log main buffer=64k flush=5s;
        {{if and .Upstream .Upstream.Servers}}proxy_pass {{upstreamScheme .Upstream}}://{{.Upstream.Name}};{{if eq (upstreamScheme .Upstream) "https"}}
        proxy_ssl_server_name on;
        proxy_ssl_name $host;
        proxy_ssl_verify off;{{end}}{{else}}proxy_pass {{.Host.ForwardScheme}}://npg_direct_{{sanitizeID .Host.ID}};
        # Direct-forward upstream is an upstream group name, so `proxy_redirect
        # default` can't derive the backend URL — rewrite backend Location/Refresh explicitly.
        proxy_redirect {{.Host.ForwardScheme}}://{{hostPort .Host.ForwardHost .Host.ForwardPort}}/ /;{{end}}
        include /etc/nginx/includes/proxy_params.conf;
    }

    # nginx checks tokens through the internal /_challenge/validate location;
    # nothing outside needs this path, and answering it would tell anyone
    # whether a token is valid.
    location = /api/v1/challenge/validate {
        return 404;
    }

    # Challenge API - Bypass GeoIP and proxy to API service (HTTP server block)
    location /api/v1/challenge/ {
        auth_request off;
        modsecurity off;

        proxy_pass http://{{apiHost}}/api/v1/challenge/;
        proxy_pass_request_body on;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
{{end}}{{end}}

{{if .AuthProvider}}{{if not .Host.SSLForceHTTPS}}
{{template "_auth_verify_location" .}}
{{template "_auth_signin_location" .}}
{{template "_auth_bypass_locations" .}}
{{end}}{{end}}

