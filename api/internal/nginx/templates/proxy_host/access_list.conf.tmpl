{{if .BannedIPs}}
# Banned IPs geo mapping for {{join .Host.DomainNames ", "}}
# Values: 1 = manual ban, 0 = trusted (override)
# Filter subscription IPs are matched by the shared $filter_sub_ip geo
# (conf.d/filter_sub_ips_geo.conf) - one radix tree for all hosts.
geo $banned_ip_{{sanitizeID .Host.ID}} {
    default 0;
{{range .BannedIPs}}
    {{.IPAddress}} 1; # {{commentText .Reason}}
{{end}}
{{range .GlobalTrustedIPs}}
    {{.}} 0; # global trusted IP (override)
{{end}}
}
{{end}}

{{if or .GlobalTrustedIPs .RateLimitEnabled}}
# Global trusted IPs geo mapping (filter subscription IP bypass)
{{- if .RateLimitEnabled}}. Written
# for a host with rate limiting even with no trusted IPs: Advanced Config may
# read it.
{{- end}}
geo $trusted_ip_{{sanitizeID .Host.ID}} {
    default 0;
{{range .GlobalTrustedIPs}}
    {{.}} 1;
{{end}}
}
{{end}}{{if or .TrustedConfigured .RateLimitEnabled}}
# Global trusted IPs and domains geo mapping (geo restriction, cloud provider,
# bot filter and rate limit bypass; bans, filter subscription IPs and the WAF
# give way to the IPs alone)
{{- if .RateLimitEnabled}}. Written for a host with rate limiting even with
# no trusted IPs or domains: its key chain reads it.
{{- end}}
geo $npg_trusted_{{sanitizeID .Host.ID}} {
    default 0;
{{- range .GlobalTrustedIPs}}
    {{.}} 1;
{{- end}}
{{- range .TrustedDNSIncludes ".geo"}}
    # dns: {{commentText .Name}}
    include {{.Path}};
{{- end}}
}
{{end}}

{{if .BlockedCloudIPRanges}}
# Blocked Cloud Provider IPs geo mapping for {{join .Host.DomainNames ", "}}
# Using include file for efficiency ({{len .BlockedCloudIPRanges}} ranges)
geo $blocked_cloud_{{sanitizeID .Host.ID}} {
    default 0;
    include /etc/nginx/conf.d/includes/cloud_ips_{{.Host.ID}}.conf;
}
{{end}}{{if .PriorityAllowConfigured}}
# Priority allow IPs/CIDRs (geo restriction, cloud provider and bot filter
# bypass). A geo block matches each entry as the range it names.
geo $npg_prio_{{sanitizeID .Host.ID}} {
    default 0;
{{- range .GeoRestriction.AllowedIPs}}
    {{.}} 1;
{{- end}}
{{- range dnsGeoIncludes .GeoRestriction.AllowedDNS}}
    # dns: {{commentText .Name}}
    include {{.Path}};
{{- end}}
}
{{end}}{{if .URIExceptionsConfigured}}
# URI block exception IPs/CIDRs (the host's and the global list)
geo $npg_uri_exc_{{sanitizeID .Host.ID}} {
    default 0;
{{- range .URIBlock.ExceptionIPs}}
    {{.}} 1;
{{- end}}
{{- range .URIExceptionDNSIncludes}}
    # dns: {{commentText .Name}}
    include {{.Path}};
{{- end}}
}
{{end}}{{range .URIBlockLocations}}{{if .ExceptionVar}}
# Exception IPs/CIDRs of one URI block rule, for its location only (#343)
geo ${{.ExceptionVar}} {
    default 0;
{{- range .ExceptionIPs}}
    {{.}} 1;
{{- end}}
}
{{end}}{{end}}

