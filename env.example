# Nginx Proxy Guard - Environment Configuration
# Copy this file to .env and modify as needed:
#   cp env.example .env

# ===========================================
# Required Settings
# ===========================================

# Database password - CHANGE THIS!
# Generate: openssl rand -base64 24
DB_PASSWORD=change-me-in-production

# JWT secret for API authentication - CHANGE THIS!
# Generate: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# ===========================================
# Optional Settings
# ===========================================

# Timezone (default: UTC)
TZ=Asia/Seoul
DB_USER=postgres
DB_NAME=nginx_proxy_guard

# ===========================================
# Docker Compatibility (Synology DSM, etc.)
# ===========================================

# Docker API version - leave empty for auto-detection (recommended)
# Only set this if auto-detection fails
# Synology DSM typically uses: 1.41 or 1.43
# DOCKER_API_VERSION=1.41

# ===========================================
# Network & Port Settings
# ===========================================

# Admin panel port (default: 81)
# UI_PORT=81

# Nginx listen ports (host network mode)
# Change these when other services occupy 80/443 (e.g., Synology Web Station)
# NGINX_HTTP_PORT=8080
# NGINX_HTTPS_PORT=8443

# API host port - port exposed to host for nginx-to-API communication
# MUST NOT conflict with NGINX_HTTP_PORT
# API_HOST_PORT=9080

# DNS resolver for nginx (space-separated, default: 127.0.0.53 8.8.8.8)
# DNS_RESOLVER=127.0.0.53 8.8.8.8

# API rate limiting (per client IP, per minute; counted in Valkey/Redis, or in
# the API's own memory when Valkey is not used)
# The admin panel spends this budget itself — the proxy host list probes one
# upstream per row and roughly thirty screens poll on timers — so raise it if a
# large install sees 429s in the panel. 0 turns the limiter off.
# API_RATE_LIMIT_PER_MINUTE=600
#
# Signing in has its own separate budget, so panel traffic can never lock you
# out of the login screen. Keep this low: it is a brake on credential stuffing.
# AUTH_RATE_LIMIT_PER_MINUTE=100

# Running without Valkey (optional). Set REDIS_URL to empty and the API keeps
# its caches and rate-limit counters in its own memory instead, which fits a
# single API container (how NPG runs); you can then drop the valkey service.
# The same in-process cache also serves while a configured Valkey has not
# connected yet. It is bounded so it cannot grow the API into an OOM kill: by
# default 1/32 of the API's memory limit (cgroup limit, GOMEMLIMIT or host
# RAM, whichever is smallest), kept within 4-64 MiB. Set a size in MiB to
# override it, or 0 to turn it off.
# REDIS_URL=
# NPG_LOCAL_CACHE_MAX_MB=

# Client-IP resolution hardening (advanced). By default the API treats any
# loopback/private peer as a proxy hop when walking X-Forwarded-For — required
# for the stock setup, where npg-proxy runs in host network mode, but it means
# a machine already on your LAN can spoof its reported address. Set this to
# exactly the addresses your proxies connect from (comma-separated CIDRs) to
# close that. Example: the docker bridge range plus the host's own address.
# Affects login lockout, rate-limit keys, token IP allow-lists and audit logs.
# TRUSTED_PROXY_CIDR=172.16.0.0/12,192.168.1.10/32

# Domain entries in access lists. Emergency switch: 1 keeps every domain
# entry closed (no client is allowed through a domain name), whatever the
# settings say; each start with it set is recorded in the audit log.
# NPG_DNS_ENTRIES_DISABLED=1
#
# Check interval for domain entries, a duration from 5s to 1h. While set it
# overrides the interval in the settings. Values under 30s are for tests:
# every check sends about 8 DNS queries per domain (more with a CNAME).
# NPG_DNS_ENTRIES_INTERVAL=60s
